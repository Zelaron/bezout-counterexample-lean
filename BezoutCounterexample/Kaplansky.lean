import BezoutCounterexample.Basic

/-!
# Kaplansky's condition, with gcd

An additive local extension of the original formalization. Its original matrix
predicates and construction are unchanged. The normalized-gcd condition is proved
equivalent to the unit-ideal and primitive-matrix conditions. The up-to-units gcd
version agrees with Anders Mörtberg's CoqEAL formulation at
https://staff.math.su.se/anders.mortberg/thesis/doc/theory/kaplansky.html.
-/

namespace Matrix

/-- The ideal generated by the entries of a matrix. -/
def entryIdeal {R m n : Type*} [CommRing R] (F : Matrix m n R) : Ideal R :=
  Ideal.span (Set.range fun ij : m × n => F ij.1 ij.2)

lemma entryIdeal_le_iff {R m n : Type*} [CommRing R] {F : Matrix m n R} {I : Ideal R} :
    entryIdeal F ≤ I ↔ ∀ i j, F i j ∈ I := by
  simp [entryIdeal, Ideal.span_le, Set.range_subset_iff]

variable {R : Type*} [CommRing R]

-- These are aliases of the original predicates, not replacement definitions.
abbrev MatrixEquivalent {m n : ℕ} (F G : Matrix (Fin m) (Fin n) R) : Prop :=
  BezoutCounterexample.MatrixEquivalent F G
abbrev HasSmithNormalForm {m n : ℕ} (F : Matrix (Fin m) (Fin n) R) : Prop :=
  BezoutCounterexample.HasSmithNormalForm F
abbrev IsElementaryDivisorDomain (R : Type*) [CommRing R] : Prop :=
  BezoutCounterexample.IsElementaryDivisorDomain R

theorem isSmithNormalForm_iff_chain {m n : ℕ} (D : Matrix (Fin m) (Fin n) R) :
    BezoutCounterexample.IsSmithNormalForm D ↔
      ∃ d : ℕ → R, (∀ i j, D i j = if (i : ℕ) = j then d i else 0) ∧
        ∀ k, k + 1 < min m n → d k ∣ d (k + 1) :=
  BezoutCounterexample.isSmithNormalForm_iff_chain D

theorem MatrixEquivalent.entry_mem {m n : ℕ} {F G : Matrix (Fin m) (Fin n) R}
    (h : MatrixEquivalent F G) (I : Ideal R) (hG : ∀ i j, G i j ∈ I) (i : Fin m) (j : Fin n) :
    F i j ∈ I := BezoutCounterexample.MatrixEquivalent.entry_mem h I hG i j

theorem MatrixEquivalent.entryIdeal_eq {m n : ℕ} {F G : Matrix (Fin m) (Fin n) R}
    (h : MatrixEquivalent F G) : entryIdeal F = entryIdeal G := by
  apply le_antisymm
  · rw [entryIdeal_le_iff]
    exact h.entry_mem _ (fun i j => Ideal.subset_span ⟨(i, j), rfl⟩)
  · obtain ⟨P, Q, hPQ⟩ := h
    rw [entryIdeal_le_iff]
    intro i j
    rw [← hPQ]
    exact BezoutCounterexample.entry_mem_of_mul _ F _ (entryIdeal F)
      (fun i j => Ideal.subset_span ⟨(i, j), rfl⟩) i j

theorem IsElementaryDivisorDomain.isBezout (h : IsElementaryDivisorDomain R) : IsBezout R :=
  BezoutCounterexample.IsElementaryDivisorDomain.isBezout h

end Matrix

namespace IsBezout

variable {R : Type*} [CommRing R] [IsBezout R] [IsCancelMulZero R]

/-- Two elements of a Bézout domain are a common factor times coprime cofactors.
This includes the case in which both elements vanish. -/
theorem exists_eq_mul_isCoprime (a b : R) :
    ∃ d r s : R, a = d * r ∧ b = d * s ∧ IsCoprime r s := by
  by_cases hzero : a = 0 ∧ b = 0
  · exact ⟨0, 1, 0, by simp [hzero.1], by simp [hzero.2], isCoprime_one_left⟩
  obtain ⟨r, hr⟩ := gcd_dvd_left a b
  obtain ⟨s, hs⟩ := gcd_dvd_right a b
  obtain ⟨u, v, huv⟩ := gcd_eq_sum a b
  generalize gcd a b = d at hr hs huv
  have hd : d ≠ 0 := by
    intro h
    exact hzero ⟨by simp [hr, h], by simp [hs, h]⟩
  refine ⟨d, r, s, hr, hs, u, v, ?_⟩
  apply mul_left_cancel₀ hd
  calc
    d * (u * r + v * s) = u * a + v * b := by rw [hr, hs]; ring
    _ = d := huv
    _ = d * 1 := (mul_one _).symm

end IsBezout

namespace Matrix

variable {R : Type*} [CommRing R] [IsBezout R] [IsCancelMulZero R]

/-- Hermite reduction in size two: an invertible determinant-one left row operation
makes the lower left entry zero. The first column is allowed to vanish. -/
theorem exists_det_one_mul_eq_upperTriangular (M : Matrix (Fin 2) (Fin 2) R) :
    ∃ (H : GL (Fin 2) R) (a b c : R),
      det (H : Matrix (Fin 2) (Fin 2) R) = 1 ∧
      (H : Matrix (Fin 2) (Fin 2) R) * M = !![a, b; 0, c] := by
  obtain ⟨d, r, s, hr, hs, u, v, huv⟩ :=
    IsBezout.exists_eq_mul_isCoprime (M 0 0) (M 1 0)
  let A : Matrix (Fin 2) (Fin 2) R := !![u, v; -s, r]
  have hdet : det A = 1 := by
    simp only [A, det_fin_two_of, mul_neg, sub_neg_eq_add]
    linear_combination huv
  let H : GL (Fin 2) R := GeneralLinearGroup.mk'' A (hdet.symm ▸ isUnit_one)
  refine ⟨H, d, u * M 0 1 + v * M 1 1, -s * M 0 1 + r * M 1 1, hdet, ?_⟩
  change A * M = _
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_two]
  fin_cases i <;> fin_cases j
  · change u * M 0 0 + v * M 1 0 = d
    rw [hr, hs]
    linear_combination d * huv
  · rfl
  · change -s * M 0 0 + r * M 1 0 = 0
    rw [hr, hs]
    ring
  · rfl

end Matrix

namespace Ideal

variable {R : Type*} [CommRing R]

/-- Three elements generate the unit ideal precisely when a linear combination is one. -/
theorem span_triple_eq_top_iff (a b c : R) :
    (span {a, b, c} : Ideal R) = ⊤ ↔ ∃ u v w : R, u * a + v * b + w * c = 1 := by
  rw [eq_top_iff_one, mem_span_insert]
  constructor
  · rintro ⟨u, z, hz, he⟩
    obtain ⟨v, w, rfl⟩ := mem_span_pair.mp hz
    exact ⟨u, v, w, by simpa only [add_assoc] using he.symm⟩
  · rintro ⟨u, v, w, h⟩
    exact ⟨u, v * b + w * c, mem_span_pair.mpr ⟨v, w, rfl⟩,
      by simpa only [add_assoc] using h.symm⟩

end Ideal

/-- Kaplansky's condition in a form independent of a choice of gcd: a primitive
triple `a, b, c` admits `p, q` such that `p * a` and `p * b + q * c` are coprime. -/
def KaplanskyCondition (R : Type*) [CommRing R] : Prop :=
  ∀ a b c : R, (Ideal.span {a, b, c} : Ideal R) = ⊤ →
    ∃ p q : R, IsCoprime (p * a) (p * b + q * c)

variable {R : Type*} [CommRing R]

open Matrix

/-- An entirely first order formulation of Kaplansky's condition. -/
theorem kaplanskyCondition_iff_exists :
    KaplanskyCondition R ↔
      ∀ a b c : R, (∃ u v w : R, u * a + v * b + w * c = 1) →
        ∃ p q s t : R, s * (p * a) + t * (p * b + q * c) = 1 := by
  simp only [KaplanskyCondition, Ideal.span_triple_eq_top_iff, IsCoprime]

/-- Kaplansky's first-order condition with a normalized gcd, using literal equality to one.
The triple gcd is nested as in Mörtberg's Coq formalization. -/
def KaplanskyConditionGCD (R : Type*) [CommRing R] [NormalizedGCDMonoid R] : Prop :=
  ∀ a b c : R, gcd a (gcd b c) = 1 →
    ∃ p q : R, gcd (p * a) (p * b + q * c) = 1

/-- The gcd condition up to units, matching `gcdr a (gcdr b c) %= 1` in CoqEAL.
This version works with any gcd operation satisfying Mathlib's gcd axioms. -/
def KaplanskyConditionGCDUpToUnits (R : Type*) [CommRing R] [GCDMonoid R] : Prop :=
  ∀ a b c : R, Associated (gcd a (gcd b c)) 1 →
    ∃ p q : R, Associated (gcd (p * a) (p * b + q * c)) 1

namespace KaplanskyCondition

/-- For a normalized gcd, being a unit means literal equality to one. -/
theorem gcd_eq_one_iff_isUnit [NormalizedGCDMonoid R] (a b : R) :
    gcd a b = 1 ↔ IsUnit (gcd a b) := by
  simpa only [normalize_gcd] using (normalize_eq_one (x := gcd a b))

/-- The first-order Bézout identity is equivalent to Mathlib's ideal-theoretic
Bézout property; the gcd axioms are supplied by `GCDMonoid`, not postulated anew. -/
theorem isBezout_iff_gcd_eq_sum [IsDomain R] [GCDMonoid R] :
    IsBezout R ↔ ∀ a b : R, ∃ x y : R, x * a + y * b = gcd a b := by
  constructor
  · intro h
    let := h
    intro a b
    obtain ⟨x, y, hxy⟩ := exists_gcd_eq_mul_add_mul a b
    exact ⟨x, y, by simpa only [mul_comm] using hxy.symm⟩
  · intro h
    rw [IsBezout.iff_span_pair_isPrincipal]
    intro a b
    refine ⟨⟨gcd a b, le_antisymm ?_ ?_⟩⟩
    · rw [Ideal.span_insert, sup_le_iff]
      exact ⟨Ideal.span_singleton_le_span_singleton.mpr (gcd_dvd_left a b),
        Ideal.span_singleton_le_span_singleton.mpr (gcd_dvd_right a b)⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      obtain ⟨x, y, hxy⟩ := h a b
      exact Ideal.mem_span_pair.mpr ⟨x, y, hxy⟩

variable [IsDomain R] [IsBezout R]

/-- A gcd of a triple generates exactly the ideal generated by that triple. -/
theorem span_triple_eq_span_gcd [GCDMonoid R] (a b c : R) :
    (Ideal.span {a, b, c} : Ideal R) = Ideal.span {gcd a (gcd b c)} := by
  rw [span_gcd a (gcd b c)]
  conv_rhs => rw [Ideal.span_insert, span_gcd b c]
  rw [Ideal.span_insert]

/-- The exact gcd antecedent agrees with the existing primitive-triple condition. -/
theorem span_triple_eq_top_iff_gcd_eq_one [NormalizedGCDMonoid R] (a b c : R) :
    (Ideal.span {a, b, c} : Ideal R) = ⊤ ↔ gcd a (gcd b c) = 1 := by
  rw [span_triple_eq_span_gcd, Ideal.span_singleton_eq_top, gcd_eq_one_iff_isUnit]

/-- The CoqEAL gcd antecedent agrees with the primitive-triple condition. -/
theorem span_triple_eq_top_iff_associated_gcd_one [GCDMonoid R] (a b c : R) :
    (Ideal.span {a, b, c} : Ideal R) = ⊤ ↔ Associated (gcd a (gcd b c)) 1 := by
  rw [span_triple_eq_span_gcd, Ideal.span_singleton_eq_top, associated_one_iff_isUnit]

end KaplanskyCondition

/-- Over a Bézout domain the existing condition is exactly the normalized-gcd
first-order condition requested by the authors. -/
theorem kaplanskyCondition_iff_gcd [IsDomain R] [IsBezout R] [NormalizedGCDMonoid R] :
    KaplanskyCondition R ↔ KaplanskyConditionGCD R := by
  simp only [KaplanskyCondition, KaplanskyConditionGCD,
    KaplanskyCondition.span_triple_eq_top_iff_gcd_eq_one,
    ← gcd_isUnit_iff, ← KaplanskyCondition.gcd_eq_one_iff_isUnit]

/-- With an arbitrary choice of gcd, the existing condition is exactly the
up-to-units condition used in Mörtberg's Coq formalization. -/
theorem kaplanskyCondition_iff_gcdUpToUnits [IsDomain R] [IsBezout R] [GCDMonoid R] :
    KaplanskyCondition R ↔ KaplanskyConditionGCDUpToUnits R := by
  simp only [KaplanskyCondition, KaplanskyConditionGCDUpToUnits,
    KaplanskyCondition.span_triple_eq_top_iff_associated_gcd_one,
    associated_one_iff_isUnit, gcd_isUnit_iff]

/-- The exact equality and up-to-units gcd formulations agree after normalization. -/
theorem kaplanskyConditionGCD_iff_upToUnits
    [IsDomain R] [IsBezout R] [NormalizedGCDMonoid R] :
    KaplanskyConditionGCD R ↔ KaplanskyConditionGCDUpToUnits R :=
  kaplanskyCondition_iff_gcd.symm.trans kaplanskyCondition_iff_gcdUpToUnits

/-- Failure of the exact first-order gcd condition exhibits a primitive triple
for which every possible pair of Kaplansky coefficients fails. -/
theorem not_kaplanskyConditionGCD_iff [NormalizedGCDMonoid R] :
    ¬ KaplanskyConditionGCD R ↔
      ∃ a b c : R, gcd a (gcd b c) = 1 ∧
        ∀ p q : R, gcd (p * a) (p * b + q * c) ≠ 1 := by
  classical
  simp only [KaplanskyConditionGCD, not_forall, not_exists, exists_prop]

namespace Matrix

/-- The entry ideal of an upper triangular matrix of size two. -/
theorem entryIdeal_upperTriangular (a b c : R) :
    entryIdeal !![a, b; 0, c] = (Ideal.span {a, b, c} : Ideal R) := by
  apply le_antisymm
  · rw [entryIdeal_le_iff]
    intro i j
    fin_cases i <;> fin_cases j
    · exact Ideal.subset_span (by simp)
    · exact Ideal.subset_span (by simp)
    · exact Ideal.zero_mem _
    · exact Ideal.subset_span (by simp)
  · rw [Ideal.span_le]
    rintro x (rfl | rfl | rfl)
    · exact Ideal.subset_span ⟨(0, 0), rfl⟩
    · exact Ideal.subset_span ⟨(0, 1), rfl⟩
    · exact Ideal.subset_span ⟨(1, 1), rfl⟩

/-- Bilinear evaluation of an upper triangular two by two matrix. -/
theorem vecMul_upperTriangular_dotProduct (a b c p q s t : R) :
    ![p, q] ᵥ* !![a, b; 0, c] ⬝ᵥ ![s, t] =
      s * (p * a) + t * (p * b + q * c) := by
  simp only [vecMul, dotProduct, Fin.sum_univ_two]
  change (p * a + q * 0) * s + (p * b + q * c) * t = _
  ring

/-- An entry-primitive two by two matrix with Smith normal form has a bilinear
unit witness. No domain or Bézout assumption is needed for this implication. -/
theorem HasSmithNormalForm.exists_vecMul_dotProduct_eq_one
    {M : Matrix (Fin 2) (Fin 2) R} (hSNF : HasSmithNormalForm M)
    (hM : entryIdeal M = ⊤) :
    ∃ p q s t : R, ![p, q] ᵥ* M ⬝ᵥ ![s, t] = 1 := by
  obtain ⟨G, hMG, hG⟩ := hSNF
  obtain ⟨d, hd, hdiv⟩ := (isSmithNormalForm_iff_chain G).1 hG
  have hd12 : d 0 ∣ d 1 := hdiv 0 (by norm_num)
  have htop : (Ideal.span {d 0, d 1} : Ideal R) = ⊤ := by
    apply top_unique
    rw [← hM, entryIdeal_le_iff]
    apply hMG.entry_mem
    intro i j
    fin_cases i <;> fin_cases j
    · rw [hd]; exact Ideal.subset_span (by simp)
    · rw [hd]; simp
    · rw [hd]; simp
    · rw [hd]; exact Ideal.subset_span (by simp)
  have hunit : IsUnit (d 0) := by
    have hspan : (Ideal.span {d 0, d 1} : Ideal R) = Ideal.span {d 0} := by
      rw [Ideal.span_insert, sup_eq_left.2 (Ideal.span_singleton_le_span_singleton.2 hd12)]
    rwa [hspan, Ideal.span_singleton_eq_top] at htop
  obtain ⟨P, Q, hPQ⟩ := hMG
  have h00 : ![(P : Matrix (Fin 2) (Fin 2) R) 0 0, (P : Matrix (Fin 2) (Fin 2) R) 0 1] ᵥ*
      M ⬝ᵥ ![(Q : Matrix (Fin 2) (Fin 2) R) 0 0, (Q : Matrix (Fin 2) (Fin 2) R) 1 0] =
      d 0 := by
    have h : ((P : Matrix (Fin 2) (Fin 2) R) * M * Q) 0 0 = d 0 := by
      rw [hPQ, hd]; simp
    rw [← h]
    simp only [Matrix.mul_apply, Fin.sum_univ_two, vecMul, dotProduct]
    rfl
  obtain ⟨μ, hμ⟩ := hunit.exists_left_inv
  refine ⟨μ * (P : Matrix (Fin 2) (Fin 2) R) 0 0,
    μ * (P : Matrix (Fin 2) (Fin 2) R) 0 1,
    (Q : Matrix (Fin 2) (Fin 2) R) 0 0, (Q : Matrix (Fin 2) (Fin 2) R) 1 0, ?_⟩
  simp only [vecMul, dotProduct, Fin.sum_univ_two] at h00 ⊢
  change ((P : Matrix (Fin 2) (Fin 2) R) 0 0 * M 0 0 +
      (P : Matrix (Fin 2) (Fin 2) R) 0 1 * M 1 0) *
        (Q : Matrix (Fin 2) (Fin 2) R) 0 0 +
    ((P : Matrix (Fin 2) (Fin 2) R) 0 0 * M 0 1 +
      (P : Matrix (Fin 2) (Fin 2) R) 0 1 * M 1 1) *
        (Q : Matrix (Fin 2) (Fin 2) R) 1 0 = d 0 at h00
  change (μ * (P : Matrix (Fin 2) (Fin 2) R) 0 0 * M 0 0 +
      μ * (P : Matrix (Fin 2) (Fin 2) R) 0 1 * M 1 0) *
        (Q : Matrix (Fin 2) (Fin 2) R) 0 0 +
    (μ * (P : Matrix (Fin 2) (Fin 2) R) 0 0 * M 0 1 +
      μ * (P : Matrix (Fin 2) (Fin 2) R) 0 1 * M 1 1) *
        (Q : Matrix (Fin 2) (Fin 2) R) 1 0 = 1
  linear_combination μ * h00 + hμ


end Matrix

namespace KaplanskyCondition

variable [IsBezout R] [IsCancelMulZero R]

/-- Kaplansky's condition supplies a bilinear unit witness for any entry-primitive
two by two matrix over a Bézout domain. -/
theorem exists_vecMul_dotProduct_eq_one (h : KaplanskyCondition R)
    (M : Matrix (Fin 2) (Fin 2) R) (hM : Matrix.entryIdeal M = ⊤) :
    ∃ p q s t : R, ![p, q] ᵥ* M ⬝ᵥ ![s, t] = 1 := by
  obtain ⟨H, a, b, c, -, hH⟩ := Matrix.exists_det_one_mul_eq_upperTriangular M
  have he : Matrix.MatrixEquivalent M !![a, b; 0, c] := ⟨H, 1, by simpa using hH⟩
  have htop : (Ideal.span {a, b, c} : Ideal R) = ⊤ := by
    rw [← Matrix.entryIdeal_upperTriangular, ← he.entryIdeal_eq]
    exact hM
  obtain ⟨p, q, s, t, hpq⟩ := h a b c htop
  let row := ![p, q] ᵥ* (H : Matrix (Fin 2) (Fin 2) R)
  have hrow : row ᵥ* M ⬝ᵥ ![s, t] = 1 := by
    rw [Matrix.vecMul_vecMul, hH, Matrix.vecMul_upperTriangular_dotProduct]
    exact hpq
  have heq : ![row 0, row 1] = row := by
    ext i
    fin_cases i <;> rfl
  exact ⟨row 0, row 1, s, t, heq.symm ▸ hrow⟩

end KaplanskyCondition

/-- Over a Bézout domain, Kaplansky's condition is equivalent to the bilinear
unit-witness property for all entry-primitive two by two matrices. -/
theorem kaplanskyCondition_iff_primitive_matrix [IsBezout R] [IsCancelMulZero R] :
    KaplanskyCondition R ↔
      ∀ M : Matrix (Fin 2) (Fin 2) R, Matrix.entryIdeal M = ⊤ →
        ∃ p q s t : R, ![p, q] ᵥ* M ⬝ᵥ ![s, t] = 1 := by
  constructor
  · exact fun h => h.exists_vecMul_dotProduct_eq_one
  · intro h a b c habc
    obtain ⟨p, q, s, t, hpq⟩ := h !![a, b; 0, c]
      ((Matrix.entryIdeal_upperTriangular a b c).trans habc)
    exact ⟨p, q, s, t, by rwa [Matrix.vecMul_upperTriangular_dotProduct] at hpq⟩

namespace Matrix

/-- Elementary divisor domains satisfy Kaplansky's condition, by the primitive
matrix criterion over the Bézout domain supplied by Smith normal form. -/
theorem IsElementaryDivisorDomain.kaplanskyCondition
    (h : IsElementaryDivisorDomain R) : KaplanskyCondition R := by
  have : IsDomain R := h.1
  have : IsBezout R := h.isBezout
  apply kaplanskyCondition_iff_primitive_matrix.mpr
  intro M hM
  exact HasSmithNormalForm.exists_vecMul_dotProduct_eq_one (h.2 2 2 M) hM

end Matrix
